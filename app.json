{
  "expo": {
    "name": "KisanSahakarApp",
    "slug": "KisanSahakarApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kisan Sahakar uses your gallery photo to analyse crop and harvest quality.",
          "cameraPermission": "Kisan Sahakar uses your camera to take crop photos for quality analysis.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
